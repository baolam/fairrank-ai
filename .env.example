# Environment variables for TMG301 Fairness-Aware Resume Ranking

# LLM Providers (Configure at least one if testing LLM API features)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Random seeds pinned by protocol
SEED_PRIMARY=17
SEED_SECONDARY=29

# Model paths and cache directories
CACHE_DIR=./data/cache
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
SECONDARY_MODEL=intfloat/e5-base-v2

# Ranking cutoff (locked by research proposal)
RANKING_CUTOFF_K=10

# Recruiter-role access code for the Candidate <-> Recruiter demo (demo-grade, not production auth)
RECRUITER_ACCESS_CODE=fairrank-demo
